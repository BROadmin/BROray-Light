#!/opt/bin/ash
umask 077

ROOT="${BRORAY_LIGHT_ROOT_PREFIX:-}/opt/broray-light"
[ "${BRORAY_ROOT:-$ROOT}" = "$ROOT" ] || exit 1
legacy_root="${BRORAY_LIGHT_ROOT_PREFIX:-}/opt/var/lock"
legacy_receipt="${BRORAY_LIGHT_ROOT_PREFIX:-}/opt/var/lib/broray-light-updater/legacy-transition.json"
legacy_finalized=false
if [ -d "${legacy_receipt%/*}" ] && [ ! -L "${legacy_receipt%/*}" ] &&
    [ -f "$legacy_receipt" ] && [ ! -L "$legacy_receipt" ] &&
    [ "$(stat -c '%u:%a:%h' "$legacy_receipt")" = 0:600:1 ] &&
    [ ! -e "$legacy_root/broray-light/global-operation.lock" ] && [ ! -L "$legacy_root/broray-light/global-operation.lock" ] &&
    [ ! -e "$legacy_root/broray-light-updater/request.lock" ] && [ ! -L "$legacy_root/broray-light-updater/request.lock" ]; then
    case "$(stat -c '%u:%a' "${legacy_receipt%/*}")" in
        0:700|0:755)
            if jq -e '.schemaVersion==1 and .product=="BROray-Light" and .sourceRelease=="1.0.0-r1" and
                .targetRelease=="2.0.0-r1" and .legacyLocks=="cleared" and .coordinator.phase=="finalized" and
                .recovery.phase=="finalized" and (.snapshotCleanup=="complete" or .snapshotCleanup=="ram-lost")' "$legacy_receipt" >/dev/null 2>&1; then legacy_finalized=true; fi ;;
    esac
fi
if [ "$legacy_finalized" != true ] && { [ -e "$legacy_receipt" ] || [ -L "$legacy_receipt" ] ||
    [ -e "$legacy_root/broray-light/global-operation.lock" ] || [ -L "$legacy_root/broray-light/global-operation.lock" ] ||
    [ -e "$legacy_root/broray-light-updater/request.lock" ] || [ -L "$legacy_root/broray-light-updater/request.lock" ]; }; then
    legacy_entry="$ROOT/releases/2.0.0-r1/app/share/lifecycle/helpers/lifecycle-r1-entry.sh"
    legacy_parent="${legacy_entry%/*}"
    while :; do
        [ -d "$legacy_parent" ] && [ ! -L "$legacy_parent" ] || exit 1
        case "$(stat -c '%u:%a' "$legacy_parent")" in 0:700|0:755) ;; *) exit 1 ;; esac
        [ "$legacy_parent" != "$ROOT" ] || break
        legacy_parent="${legacy_parent%/*}"
    done
    [ -f "$legacy_entry" ] && [ ! -L "$legacy_entry" ] && [ "$(stat -c '%u:%a:%h' "$legacy_entry")" = 0:644:1 ] || exit 1
    . "$legacy_entry" || exit 1
    legacy_rc=0
    brl_r1_entry service "${1:-}" || legacy_rc=$?
    case "$legacy_rc" in 0) ;; 10) exit 0 ;; *) exit 1 ;; esac
fi
. "$ROOT/lib/runtime-environment.sh" || exit 1
if [ "${1:-}" = recover ]; then exit 0; fi
. "$ROOT/lib/service-process.sh" || exit 1
. "$ROOT/lib/xray-process.sh" || exit 1
BRORAY_XRAY_BINARY="$ROOT/runtime/xray"
BRORAY_XRAY_CONFIG="$ROOT/config/config.json"
export BRORAY_XRAY_BINARY BRORAY_XRAY_CONFIG
WEB_CTL="${BRORAY_LIGHT_ROOT_PREFIX:-}/opt/bin/broray-light-web-publishctl"
GATE="${BRORAY_LIGHT_ROOT_PREFIX:-}/opt/libexec/broray-light-web-publish/start-gate.sh"
brl_ram_file_valid "$GATE" 2>/dev/null || {
    [ -f "$GATE" ] && [ ! -L "$GATE" ] && [ "$(stat -c '%u:%a' "$GATE")" = 0:755 ] || exit 1
}
. "$GATE" || exit 1

wait_role()
{
    local role i
    role="$1"; i=0
    while [ "$i" -lt 5 ]; do
        brl_service_running "$role" && return 0
        sleep 1; i=$((i+1))
    done
    return 1
}

start_role()
{
    local role rc binary
    role="$1"; rc=0
    brl_service_before_start "$role" || rc=$?
    case "$rc" in 0) return 0 ;; 1) ;; *) return 1 ;; esac
    case "$role" in
        web)
            binary="$(command -v lighttpd)" || return 1
            "$binary" -f "$ROOT/config/lighttpd.conf" || return 1 ;;
        daemon) "$ROOT/bin/broray-lightd" >>"$BRL_RAM/logs/broray-lightd.log" 2>&1 & ;;
        *) return 1 ;;
    esac
    wait_role "$role"
}

start()
{
    "$ROOT/bin/broray-runtime-prepare" || return 1
    # An update normally has an already owned publication. Do not borrow the
    # updater lock or issue router mutations merely to restart an owned WebUI.
    "$WEB_CTL" status >/dev/null 2>&1 || broray_light_web_publication_start_gate "$WEB_CTL" || return 1
    start_role web && start_role daemon
}

stop()
{
    brl_service_stop_role daemon && brl_service_stop_role web && brl_service_stop_role auth || return 1
    "$ROOT/bin/broray-xray-control" stop >/dev/null 2>&1 || return 1
    [ -z "$(broray_xray_runtime_pids)" ]
}

status()
{
    brl_service_running daemon && brl_service_running web && "$WEB_CTL" status >/dev/null
}

case "${1:-}" in
    start|stop|status) "$1" ;;
    restart) stop && start ;;
    *) echo 'Usage: S24broray-light {start|stop|restart|status}' >&2; exit 1 ;;
esac
