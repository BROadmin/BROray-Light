#!/opt/bin/ash
ROOT="${BRORAY_ROOT:-/opt/broray-light}"; cmd="${1:-info}"; shift 2>/dev/null || true
case "$cmd" in info|status) exec "$ROOT/bin/broray-system" info;; server|servers) exec "$ROOT/bin/broray-servers" "$@";; subscriptions) exec "$ROOT/bin/broray-subscriptions" "$@";; *) echo "BROray-Light: info | servers | subscriptions" >&2; exit 1;; esac
