#!/opt/bin/ash

set -eu
umask 077
ROOT_PREFIX="${BRORAY_LIGHT_ROOT_PREFIX:-}"
APP_ROOT="$ROOT_PREFIX/opt/broray-light"
RELEASE_ID='@RELEASE_ID@'
XRAY_VERSION='@XRAY_VERSION@'
XRAY_SHA256='@XRAY_BINARY_SHA256@'
@BOOTSTRAP_RAM_HELPERS@
@RUNTIME_RAM_HELPERS@
XRAY_SOURCE="$BOOTSTRAP_ROOT/xray-$XRAY_VERSION"
XRAY_RUNTIME="$APP_ROOT/runtime/xray"
APP_INIT="$ROOT_PREFIX/opt/etc/init.d/S24broray-light"
UPDATER_INIT="$ROOT_PREFIX/opt/etc/init.d/S23broray-light-updater"

fail()
{
    echo "ERROR: $*" >&2
    exit 1
}

ensure_directory()
{
    local path
    path="$1"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then mkdir "$path" || fail 'cannot create durable directory'; fi
    [ -d "$path" ] && [ ! -L "$path" ] || fail 'foreign durable directory type'
    case "$(stat -c '%u:%a' "$path")" in 0:700|0:755) ;; *) fail 'foreign durable directory owner/mode' ;; esac
}

xray_executable()
{
    if [ -n "${BRORAY_LIGHT_XRAY_EXECUTABLE_HOOK:-}" ]; then
        "$BRORAY_LIGHT_XRAY_EXECUTABLE_HOOK" "$1"
    else
        [ -x "$1" ]
    fi
}

ensure_link()
{
    link_path="$1"; target="$2"
    if [ -L "$link_path" ]; then
        [ "$(readlink "$link_path")" = "$target" ] || fail "foreign symlink at $link_path"
    elif [ -e "$link_path" ]; then
        fail "foreign object at $link_path"
    else
        ln -s "$target" "$link_path" || fail "cannot create $link_path"
    fi
}

bootstrap_owned || fail 'protected RAM bootstrap namespace is not owned by this package'
bootstrap_finish()
{
    bootstrap_rc=$?
    trap - 0
    bootstrap_cleanup || { echo 'ERROR: bootstrap cleanup refused; inspect RAM namespace.' >&2; bootstrap_rc=1; }
    exit "$bootstrap_rc"
}
trap bootstrap_finish 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

case "$ROOT_PREFIX" in ''|/*) ;; *) fail 'invalid root prefix' ;; esac
case "$ROOT_PREFIX" in *[!A-Za-z0-9/_.-]*|*/../*|*/..|*/./*|*/.|*//*|*/) fail 'unsafe root prefix' ;; esac
[ ! -e "$APP_ROOT/current" ] && [ ! -L "$APP_ROOT/current" ] || fail 'already installed; signed updater required'
for directory in opt opt/broray-light opt/broray-light/releases opt/broray-light/config \
    opt/broray-light/config/system opt/broray-light/servers opt/broray-light/subscriptions \
    opt/broray-light/runtime opt/broray-light/backup opt/var opt/var/lib \
    opt/var/lib/broray-light opt/var/lib/broray-light/operations opt/var/lib/broray-light-updater; do
    ensure_directory "$ROOT_PREFIX/$directory"
done
TARGET_SLOT="$APP_ROOT/releases/$RELEASE_ID"
ensure_directory "$TARGET_SLOT"
[ -d "$TARGET_SLOT/app" ] && [ ! -L "$TARGET_SLOT/app" ] &&
    [ -f "$TARGET_SLOT/APP-SHA256SUMS" ] && [ ! -L "$TARGET_SLOT/APP-SHA256SUMS" ] || fail 'initial slot manifest missing'
[ -z "$(find "$TARGET_SLOT" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)" ] || fail 'unsafe slot member type'
awk 'NF!=2 || length($1)!=64 || $1~/[^a-f0-9]/ {bad=1}
    $2!="release.json" && $2!~/^app\// {bad=1}
    $2~/[^A-Za-z0-9_.\/-]/ || $2~/\.\./ || $2~/\/\.\// || $2~/\/\// {bad=1}
    {if(seen[$2]++)bad=1; if($2=="release.json")release++}
    END{exit (bad || release!=1)}' "$TARGET_SLOT/APP-SHA256SUMS" || fail 'invalid slot manifest'
[ "$(find "$TARGET_SLOT/app" -type f | wc -l)" -eq "$(awk 'END{print NR-1}' "$TARGET_SLOT/APP-SHA256SUMS")" ] || fail 'unlisted slot file'
(cd "$TARGET_SLOT" && sha256sum -c APP-SHA256SUMS >/dev/null) || fail 'initial slot hash mismatch'
jq -e --arg id "$RELEASE_ID" '.product=="BROray-Light" and .releaseId==$id' "$TARGET_SLOT/release.json" >/dev/null || fail 'initial slot identity mismatch'
brl_ram_prepare && brl_legacy_locks_clear || fail 'protected operational RAM is unavailable'
for directory in run logs tmp update; do
    brl_ram_child "$BRL_RAM/$directory" || fail 'RAM operational child refused'
    ensure_link "$APP_ROOT/$directory" "$BRL_RAM/$directory"
done

if [ -e "$XRAY_RUNTIME" ] || [ -L "$XRAY_RUNTIME" ]; then
    if [ ! -f "$XRAY_RUNTIME" ] || [ -L "$XRAY_RUNTIME" ] || ! xray_executable "$XRAY_RUNTIME"; then
        fail 'existing Xray runtime is not a verified regular executable'
    fi
    if [ -n "${BRORAY_LIGHT_XRAY_VERIFY_HOOK:-}" ]; then
        "$BRORAY_LIGHT_XRAY_VERIFY_HOOK" "$XRAY_RUNTIME" || fail 'existing Xray verification hook failed'
    else
        "$XRAY_RUNTIME" version 2>/dev/null | sed -n '1s/^Xray [^ ]*.*/PASS/p' | grep -q '^PASS$' ||
            fail 'existing Xray runtime cannot report a valid version'
    fi
else
    [ -f "$XRAY_SOURCE" ] && [ ! -L "$XRAY_SOURCE" ] || fail 'verified Xray bootstrap payload is absent'
    [ "$(sha256sum "$XRAY_SOURCE" | awk 'NR==1{print $1}')" = "$XRAY_SHA256" ] ||
        fail 'Xray bootstrap payload SHA-256 mismatch'
    [ ! -L "$APP_ROOT/runtime" ] || fail 'runtime parent is a symlink'
    [ ! -e "$XRAY_RUNTIME.new" ] && [ ! -L "$XRAY_RUNTIME.new" ] || fail 'runtime staging path already exists'
    cp "$XRAY_SOURCE" "$XRAY_RUNTIME.new" || fail 'cannot stage Xray runtime'
    chmod 755 "$XRAY_RUNTIME.new" || fail 'cannot set Xray executable mode'
    [ "$(sha256sum "$XRAY_RUNTIME.new" | awk 'NR==1{print $1}')" = "$XRAY_SHA256" ] ||
        fail 'staged Xray runtime SHA-256 mismatch'
    mv "$XRAY_RUNTIME.new" "$XRAY_RUNTIME" || fail 'cannot install Xray runtime'
fi

xray_executable "$XRAY_RUNTIME" || fail 'clean install did not produce an executable Xray runtime'
rm -f "$XRAY_SOURCE"

[ -d "$TARGET_SLOT/app" ] && [ -r "$TARGET_SLOT/release.json" ] || fail 'initial app slot is missing'
CURRENT_PATH="$APP_ROOT/current"
CURRENT_STAGED="$APP_ROOT/.current.postinst.$$"
[ ! -e "$CURRENT_STAGED" ] && [ ! -L "$CURRENT_STAGED" ] || fail 'staged current link already exists'
ln -s "releases/$RELEASE_ID" "$CURRENT_STAGED" || fail 'cannot stage target app slot'
mv -fT "$CURRENT_STAGED" "$CURRENT_PATH" || fail 'cannot activate target app slot'

ensure_link "$APP_ROOT/bin" 'current/app/bin'
ensure_link "$APP_ROOT/lib" 'current/app/lib'
ensure_link "$APP_ROOT/share" 'current/app/share'
ensure_link "$APP_ROOT/web-new" 'current/app/web-new'

for seed in system/settings.json system/server-auto-switch.json lighttpd.conf; do
    destination="$APP_ROOT/config/$seed"
    source="$APP_ROOT/current/app/share/defaults/${seed##*/}"
    if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
        (set -C; cat "$source" > "$destination") || fail "cannot seed $seed"
    fi
    [ -f "$destination" ] && [ ! -L "$destination" ] && [ -s "$destination" ] &&
        [ "$(stat -c '%u:%h' "$destination")" = 0:1 ] || fail 'foreign configuration file'
    case "$(stat -c '%a' "$destination")" in 600|644) ;; *) fail 'unsafe configuration mode' ;; esac
done
VERSION_PATH="$APP_ROOT/config/version"
VERSION_STAGED="$APP_ROOT/config/.version.postinst.$$"
[ ! -L "$VERSION_PATH" ] || fail 'managed version path is a symlink'
[ ! -d "$VERSION_PATH" ] || fail 'managed version path is a directory'
[ ! -e "$VERSION_STAGED" ] && [ ! -L "$VERSION_STAGED" ] || fail 'staged version file already exists'
(set -C; printf '%s\n' "$RELEASE_ID" > "$VERSION_STAGED") || fail 'cannot stage release identity'
chmod 600 "$VERSION_STAGED" || fail 'cannot protect release identity'
mv -fT "$VERSION_STAGED" "$VERSION_PATH" || fail 'cannot activate release identity'

chmod 755 "$APP_INIT" "$UPDATER_INIT" \
    "$ROOT_PREFIX/opt/bin/broray-light-updaterctl" \
    "$ROOT_PREFIX/opt/bin/broray-light-web-publishctl" \
    "$ROOT_PREFIX/opt/libexec/broray-light-updater/broray-light-updater.sh" \
    "$ROOT_PREFIX/opt/libexec/broray-light-updater/minisign" \
    "$ROOT_PREFIX/opt/libexec/broray-light-web-publish/broray-light-web-publish.sh" \
    "$ROOT_PREFIX/opt/libexec/broray-light-web-publish/start-gate.sh" \
    "$ROOT_PREFIX/opt/libexec/broray-light-web-publish/network.sh" \
    "$ROOT_PREFIX/opt/libexec/broray-light-web-publish/policy.sh"

if [ "${BRORAY_LIGHT_SKIP_SERVICE_START:-0}" != 1 ]; then
    "$UPDATER_INIT" start || fail 'Light updater control plane failed to start'
    "$APP_INIT" start || fail 'BROray-Light primary service failed to start'
fi

exit 0
