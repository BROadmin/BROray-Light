#!/opt/bin/ash

BRORAY_ROOT="${BRORAY_ROOT:-/opt/broray-light}"

. "$BRORAY_ROOT/lib/subscription-service.sh"
. "$BRORAY_ROOT/lib/operation-lock.sh"

usage()
{
    cat <<'HELP'
BROray Subscriptions

Использование:
  broray-subscriptions list|get|create|update|refresh|servers|delete|summary
  broray-subscriptions scheduler-once|recover|deduplicate
HELP
}

read_json_input()
{
    input_source="$1"
    input_temp="$BRORAY_ROOT/tmp/subscription-cli-body.$$.json"
    mkdir -p "$BRORAY_ROOT/tmp"
    if [ "$input_source" = "-" ]; then
        cat > "$input_temp"
    else
        cp "$input_source" "$input_temp"
    fi
    printf '%s\n' "$input_temp"
}

broray_subscription_owner_map_prepare()
{
    BRORAY_DEDUPE_OWNER_MAP="$BRORAY_ROOT/config/system/server-canonical-owners.json"
    BRORAY_DEDUPE_OWNERS='{"schemaVersion":1,"identity":{},"import":{}}'
    [ -d "$BRORAY_ROOT/config" ] && [ ! -L "$BRORAY_ROOT/config" ] || return 1
    mkdir -p "$BRORAY_ROOT/config/system" || return 1
    [ -d "$BRORAY_ROOT/config/system" ] && [ ! -L "$BRORAY_ROOT/config/system" ] || return 1
    if [ -e "$BRORAY_DEDUPE_OWNER_MAP" ] || [ -L "$BRORAY_DEDUPE_OWNER_MAP" ]; then
        [ -f "$BRORAY_DEDUPE_OWNER_MAP" ] && [ ! -L "$BRORAY_DEDUPE_OWNER_MAP" ] || return 1
        jq -e 'type=="object" and .schemaVersion==1 and
          (.identity|type=="object" and all(.[];type=="string" and length>0)) and
          (.import|type=="object" and all(.[];type=="string" and length>0))' \
          "$BRORAY_DEDUPE_OWNER_MAP" >/dev/null || return 1
        BRORAY_DEDUPE_OWNERS="$(cat "$BRORAY_DEDUPE_OWNER_MAP")" || return 1
    fi
}

broray_subscription_owner_map_save()
{
    local inventory adjacent
    inventory="$1"
    # Adjacent durable configuration transaction, never an archive/download.
    adjacent="$(umask 077; mktemp "$BRORAY_ROOT/config/system/.server-canonical-owners.XXXXXX")" || return 1
    if ! jq -s '
      {schemaVersion:1,
       identity:(map(select((.identityKey // "") != "")|{key:.identityKey,value:.id})|from_entries),
       import:(map(select((.source.importKey // "") != "")|{key:.source.importKey,value:.id})|from_entries)}
      ' "$inventory" >"$adjacent"; then
        rm -f "$adjacent"; return 1
    fi
    [ ! -L "$BRORAY_DEDUPE_OWNER_MAP" ] || { rm -f "$adjacent"; return 1; }
    chmod 600 "$adjacent" && mv -f "$adjacent" "$BRORAY_DEDUPE_OWNER_MAP" || { rm -f "$adjacent"; return 1; }
}

broray_subscription_dedupe_pass()
{
    dedupe_field="$1"
    dedupe_backup="$2"
    dedupe_inventory="$BRORAY_ROOT/tmp/server-deduplicate-$dedupe_field.$$.jsonl"
    dedupe_remove="$BRORAY_ROOT/tmp/server-deduplicate-$dedupe_field.$$.remove"
    : > "$dedupe_inventory" || return 1

    for dedupe_file in "$BRORAY_ROOT"/servers/*.json; do
        [ -f "$dedupe_file" ] && [ ! -L "$dedupe_file" ] || continue
        jq --arg file "$dedupe_file" '. + {__file:$file}' "$dedupe_file" >> "$dedupe_inventory" || return 1
    done

    dedupe_active="$(cat "$BRORAY_ROOT/config/active-server" 2>/dev/null || true)"
    jq -s -r --arg field "$dedupe_field" --arg active "$dedupe_active" --argjson owners "$BRORAY_DEDUPE_OWNERS" '
      map(. + {__key:(if $field=="identity" then (.identityKey // "") else (.source.importKey // "") end)})
      | map(select(.__key != ""))
      | sort_by(.__key)
      | group_by(.__key)
      | map(select(length > 1))[]
      | sort_by([if .id == $active then 0 elif (.source.type // "manual") == "manual" then 1 else 2 end,
          (if $owners[$field][.__key] == .id then 0 else 1 end), .id])
      | .[1:][]?.__file
    ' "$dedupe_inventory" > "$dedupe_remove" || return 1

    while IFS= read -r dedupe_file; do
        [ -n "$dedupe_file" ] || continue
        case "$dedupe_file" in
            "$BRORAY_ROOT"/servers/*.json) ;;
            *) return 1 ;;
        esac
        [ -f "$dedupe_file" ] && [ ! -L "$dedupe_file" ] || return 1
        mkdir -p "$dedupe_backup" || return 1
        cp -p "$dedupe_file" "$dedupe_backup/${dedupe_file##*/}" || return 1
    done < "$dedupe_remove"

    while IFS= read -r dedupe_file; do
        [ -n "$dedupe_file" ] || continue
        rm -f "$dedupe_file" || return 1
        BRORAY_DEDUPE_REMOVED=$((BRORAY_DEDUPE_REMOVED + 1))
    done < "$dedupe_remove"

    rm -f "$dedupe_inventory" "$dedupe_remove"
}

broray_subscription_deduplicate()
{
    mkdir -p "$BRORAY_ROOT/servers" "$BRORAY_ROOT/backup" "$BRORAY_ROOT/tmp" || return 1
    broray_subscription_owner_map_prepare || return 1
    BRORAY_DEDUPE_REMOVED=0
    dedupe_backup="$BRORAY_ROOT/backup/server-deduplicate-$(date '+%Y%m%d-%H%M%S')-$$"

    broray_subscription_dedupe_pass identity "$dedupe_backup" || return 1
    broray_subscription_dedupe_pass import "$dedupe_backup" || return 1

    dedupe_ids="$BRORAY_ROOT/tmp/server-deduplicate-ids.$$.jsonl"
    : > "$dedupe_ids" || return 1
    for dedupe_file in "$BRORAY_ROOT"/servers/*.json; do
        [ -f "$dedupe_file" ] && [ ! -L "$dedupe_file" ] || continue
        jq -c '{id,identityKey,source}' "$dedupe_file" >> "$dedupe_ids" || return 1
    done
    dedupe_id_array="$(jq -s '[.[].id]' "$dedupe_ids")" || return 1
    broray_subscription_owner_map_save "$dedupe_ids" || return 1
    rm -f "$dedupe_ids"

    dedupe_config="$BRORAY_ROOT/config/system/server-auto-switch.json"
    if [ -f "$dedupe_config" ] && [ ! -L "$dedupe_config" ]; then
        jq --argjson ids "$dedupe_id_array" '
          .orderedServerIds = [(.orderedServerIds // [])[] | select(. as $id | $ids | index($id))]
          | .excludedServerIds = [(.excludedServerIds // [])[] | select(. as $id | $ids | index($id))]
        ' "$dedupe_config" > "$dedupe_config.$$" &&
            chmod 600 "$dedupe_config.$$" && mv "$dedupe_config.$$" "$dedupe_config" || return 1
    fi

    if [ "$BRORAY_DEDUPE_REMOVED" -eq 0 ]; then
        rmdir "$dedupe_backup" 2>/dev/null || true
        dedupe_backup=""
    fi
    jq -n --argjson removed "$BRORAY_DEDUPE_REMOVED" --arg backup "$dedupe_backup" \
        '{ok:true,removed:$removed,backup:(if $backup=="" then null else $backup end)}'
}

broray_subscription_run_due()
{
    broray_subscription_prepare_dirs || return 1
    scheduler_now="$(broray_subscription_now_epoch)"
    scheduler_due=0
    scheduler_updated=0
    scheduler_failed=0

    for scheduler_file in "$BRORAY_SUB_DIR"/*.json; do
        [ -f "$scheduler_file" ] && [ ! -L "$scheduler_file" ] || continue
        broray_subscription_validate_file "$scheduler_file" || continue
        scheduler_enabled="$(jq -r '.enabled' "$scheduler_file")"
        scheduler_auto="$(jq -r '.autoUpdateEnabled' "$scheduler_file")"
        scheduler_next="$(jq -r '.nextUpdateEpoch // 0' "$scheduler_file")"
        scheduler_id="$(jq -r '.id' "$scheduler_file")"
        [ "$scheduler_enabled" = true ] && [ "$scheduler_auto" = true ] || continue
        case "$scheduler_next" in ''|*[!0-9]*) scheduler_next=0 ;; esac
        [ "$scheduler_next" -gt 0 ] && [ "$scheduler_next" -le "$scheduler_now" ] || continue
        scheduler_due=$((scheduler_due + 1))
        if broray_subscription_update "$scheduler_id" automatic >/dev/null 2>&1; then
            scheduler_updated=$((scheduler_updated + 1))
        else
            scheduler_failed=$((scheduler_failed + 1))
        fi
    done

    jq -n \
        --argjson due "$scheduler_due" \
        --argjson updated "$scheduler_updated" \
        --argjson failed "$scheduler_failed" \
        '{ok:($failed == 0),due:$due,updated:$updated,failed:$failed}'
    [ "$scheduler_failed" -eq 0 ]
}

broray_subscription_scheduler_once_locked()
{
    scheduler_lock_rc=0
    broray_operation_lock_acquire "subscriptions:scheduler" || scheduler_lock_rc=$?
    case "$scheduler_lock_rc" in
        0) trap 'broray_operation_lock_release >/dev/null 2>&1 || true' EXIT ;;
        2)
            jq -n '{ok:true,skipped:"operation-busy",due:0,updated:0,failed:0}'
            return 0
            ;;
        *)
            jq -n '{ok:false,error:"global-lock-failed",due:0,updated:0,failed:0}'
            return 1
            ;;
    esac

    scheduler_result=0
    broray_subscription_run_due || scheduler_result=$?
    if [ "$scheduler_result" -eq 0 ] && ! broray_subscription_deduplicate >/dev/null; then
        scheduler_result=1
    fi
    [ "$scheduler_result" -ne 0 ] || broray_subscription_summary
    broray_operation_lock_release >/dev/null 2>&1 || scheduler_result=1
    trap - EXIT
    return "$scheduler_result"
}

command_name="${1:-list}"
case "$command_name" in
    list) broray_subscription_list ;;
    get) broray_subscription_get "${2:-}" ;;
    create)
        body_file="$(read_json_input "${2:--}")" || exit 1
        broray_subscription_create "$body_file"
        result="$?"
        rm -f "$body_file"
        if [ "$result" -eq 0 ] && ! broray_subscription_deduplicate >/dev/null; then result=1; fi
        exit "$result"
        ;;
    update)
        subscription_id="${2:-}"
        body_file="$(read_json_input "${3:--}")" || exit 1
        broray_subscription_update_settings "$subscription_id" "$body_file"
        result="$?"
        rm -f "$body_file"
        if [ "$result" -eq 0 ] && ! broray_subscription_deduplicate >/dev/null; then result=1; fi
        exit "$result"
        ;;
    refresh|update-now)
        broray_subscription_update "${2:-}" manual
        result="$?"
        if [ "$result" -eq 0 ] && ! broray_subscription_deduplicate >/dev/null; then result=1; fi
        exit "$result"
        ;;
    servers) broray_subscription_servers "${2:-}" ;;
    delete) broray_subscription_delete "${2:-}" ;;
    summary) broray_subscription_summary ;;
    scheduler-once)
        broray_subscription_scheduler_once_locked
        exit "$?"
        ;;
    recover)
        broray_subscription_recover_stale
        broray_subscription_list
        ;;
    deduplicate) broray_subscription_deduplicate ;;
    help|--help|-h) usage ;;
    *)
        printf 'Неизвестная команда: %s\n\n' "$command_name" >&2
        usage >&2
        exit 1
        ;;
esac
